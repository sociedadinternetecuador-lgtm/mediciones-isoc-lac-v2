    "about":  {
                  "title":  "About the DNSSEC Observatory",
                  "what_title":  "What is it?",
                  "what_text":  "The DNSSEC Observatory is a DNS results interpretation tool developed by ISOC Ecuador with support from CORPECE, within the Ecuadorian Technical Observatories (OTE) program.",
                  "how_title":  "How does it work?",
                  "how_text":  "It runs DNSViz locally to obtain technical DNSSEC data, then interprets it through three layers: code catalog, normative mapping (NIST, ISO 27001, RFCs) and plain-language explanations.",
                  "why_title":  "Why does DNSSEC matter?",
                  "why_text":  "DNSSEC protects the domain name system against cache poisoning and DNS spoofing attacks.",
                  "contact_title":  "Contact",
                  "version_label":  "Version",
                  "mission_title":  "Why does this tool exist?",
                  "mission_text":  "\u003cp\u003eThe DNSSEC Observatory exists to make technical DNSSEC results easier to understand.\u003c/p\u003e\u003cp\u003eIts purpose is to translate and explain, in plain language, the technical error messages, warnings and states that DNSViz produces when analyzing a domain\u0027s DNSSEC configuration.\u003c/p\u003e\u003cp\u003e\u003cstrong\u003eThis tool does not replace DNSViz and does not perform its own cryptographic analysis.\u003c/strong\u003e It is an interpretation layer that helps administrators, institutions and users understand what each result means.\u003c/p\u003e",
                  "credit_title":  "Credit to DNSViz",
                  "credit_text":  "\u003cp\u003eThis Observatory expressly acknowledges the work of the DNSViz project, a widely used tool for visualizing and analyzing the DNSSEC status of domains and DNS zones.\u003c/p\u003e\u003cp\u003eThe Observatory runs DNSViz locally and interprets its results. It does not replace DNSViz.\u003c/p\u003e\u003cp\u003eWe recognize the contribution of the open source community that maintains DNSViz, essential for DNS ecosystem security and transparency.\u003c/p\u003e",
                  "credit_link":  "Visit DNSViz on GitHub",
                  "disclaimer_title":  "Important notice about results",
                  "disclaimer_text":  "\u003cp\u003eThe results presented are \u003cstrong\u003ereferential\u003c/strong\u003e and should be understood as an aid for interpreting technical DNSSEC information.\u003c/p\u003e\u003cp\u003eResults may not exactly match dnsviz.net because scope, network perspective, IPv6 connectivity, analysis time and available data may differ.\u003c/p\u003e\u003cp\u003eFor critical security or compliance decisions, reviewing dnsviz.net directly and consulting a technical specialist is recommended.\u003c/p\u003e",
                  "standards_title":  "Standards and references",
                  "standards_text":  "\u003cp\u003eInterpretations rely on DNS and DNSSEC technical standards, especially RFC documents describing DNS operation, zone signing, chain of trust and validation criteria.\u003c/p\u003e",
                  "open_source_title":  "Open source",
                  "open_source_text":  "This Observatory is part of the OTE program aimed at promoting evidence-based public policies. Its development is transparent, reusable and useful for the technical, academic and institutional community."
              },
