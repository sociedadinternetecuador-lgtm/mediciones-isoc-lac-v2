<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reporte — Observatorio DNSSEC</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>

  <header class="site-header">
    <div class="container">
      <div class="header-inner">
        <a href="/" class="header-brand">
          <div class="header-logos">
            <div class="header-logo-placeholder">ISOC EC</div>
            <div class="header-logo-placeholder">CORPECE</div>
          </div>
          <span class="header-title" data-i18n="home.hero_title">Observatorio DNSSEC</span>
        </a>
        <nav class="header-nav">
          <a href="/" data-i18n="nav.home">Inicio</a>
          <a href="/about" data-i18n="nav.about">Acerca de</a>
          <button class="btn-lang" onclick="I18n.toggle()" data-lang-toggle>English</button>
          <a href="/admin/login" class="btn-login-header" data-i18n="nav.admin">Administración</a>
        </nav>
        <button class="header-menu-toggle" id="menu-toggle" aria-label="Menú">☰</button>
      </div>
    </div>
    <nav class="header-mobile-nav" id="mobile-nav">
      <a href="/" data-i18n="nav.home">Inicio</a>
      <a href="/about" data-i18n="nav.about">Acerca de</a>
      <button onclick="I18n.toggle()" data-lang-toggle>English</button>
    </nav>
  </header>

  <main>
    <div class="container" style="padding-top:1.5rem;padding-bottom:3rem">

      <!-- Loader -->
      <div id="loader" class="loader-wrap visible">
        <div class="spinner"></div>
        <p class="loader-msg" data-i18n="home.analyzing_message">Cargando reporte...</p>
      </div>

      <!-- Contenido -->
      <div id="report-wrap" class="hidden">

        <!-- Cabecera -->
        <div style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:.75rem;margin-bottom:1.5rem">
          <div>
            <a href="/" class="btn btn-sm" style="margin-bottom:.5rem">← <span data-i18n="report.new_analysis">Nuevo análisis</span></a>
            <div style="display:flex;align-items:center;gap:.6rem;flex-wrap:wrap;margin-top:.25rem">
              <span id="res-domain" style="font-size:1.2rem;font-weight:700;font-family:var(--font-mono)"></span>
              <span id="res-status" class="status-badge"></span>
            </div>
            <div style="font-size:.8rem;color:var(--color-text-muted);margin-top:.2rem">
              <span data-i18n="report.analyzed_at">Analizado el</span>
              <span id="res-date"></span>
            </div>
          </div>
          <div style="display:flex;gap:.5rem;flex-wrap:wrap">
            <button class="btn btn-sm" onclick="Report.exportJson()"><span data-i18n="report.export_json">Exportar JSON</span></button>
            <button class="btn btn-sm" onclick="window.print()"><span data-i18n="report.print">Imprimir</span></button>
          </div>
        </div>

        <!-- Métricas -->
        <div class="metrics-grid" style="margin-bottom:1.5rem">
          <div class="metric-card metric-critical"><div class="metric-number" id="cnt-critical">0</div><div class="metric-label" data-i18n="severity.CRITICAL">Crítico</div></div>
          <div class="metric-card metric-high">    <div class="metric-number" id="cnt-high">0</div>    <div class="metric-label" data-i18n="severity.HIGH">Alto</div></div>
          <div class="metric-card metric-medium">  <div class="metric-number" id="cnt-medium">0</div>  <div class="metric-label" data-i18n="severity.MEDIUM">Medio</div></div>
          <div class="metric-card">                <div class="metric-number" id="cnt-low">0</div>     <div class="metric-label" data-i18n="severity.LOW">Bajo</div></div>
          <div class="metric-card metric-success"> <div class="metric-number" id="cnt-warnings">0</div><div class="metric-label" data-i18n="report.warnings_title">Avisos</div></div>
        </div>

        <!-- Cadena de confianza -->
        <div class="card" style="margin-bottom:1.5rem">
          <div style="font-size:.78rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem"
               data-i18n="report.trust_chain">Cadena de confianza</div>
          <div id="trust-chain" class="trust-chain"></div>
          <div style="margin-top:.875rem;padding-top:.75rem;border-top:.5px solid var(--color-border-light)">
            <div style="font-size:.78rem;font-weight:600;color:var(--color-text-muted);text-transform:uppercase;letter-spacing:.05em;margin-bottom:.4rem"
                 data-i18n="report.nameservers">Servidores de nombres</div>
            <div id="ns-list" style="display:flex;flex-wrap:wrap;gap:.4rem"></div>
          </div>
        </div>

        <!-- Detalle errores -->
        <div style="margin-bottom:1.5rem">
          <div class="section-title" data-i18n="report.errors_title">Problemas encontrados</div>
          <div class="section-subtitle" id="errors-subtitle"></div>
          <div id="error-list" class="error-list"></div>
          <div id="no-errors" class="card text-center hidden" style="padding:2rem">
            <p data-i18n="report.no_errors">No se detectaron errores.</p>
          </div>
        </div>

        <!-- Advertencias -->
        <div style="margin-bottom:1.5rem">
          <div class="section-title" data-i18n="report.warnings_title">Advertencias</div>
          <div id="warnings-list" class="error-list"></div>
          <div id="no-warnings" class="card text-center hidden" style="padding:2rem">
            <p data-i18n="report.no_warnings">No se detectaron advertencias.</p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <footer class="site-footer">
    <div class="container">
      <div class="footer-inner">
        <div class="footer-orgs">
          <div class="footer-org">
            <span style="font-size:.78rem;color:rgba(255,255,255,.5)" data-i18n="home.footer_dev">Desarrollado por</span>
            <div class="footer-org-placeholder">ISOC EC</div>
            <span style="font-size:.82rem">ISOC Ecuador</span>
          </div>
          <div class="footer-org">
            <span style="font-size:.78rem;color:rgba(255,255,255,.5)" data-i18n="home.footer_support">Con apoyo de</span>
            <div class="footer-org-placeholder">CORPECE</div>
            <span style="font-size:.82rem">CORPECE</span>
          </div>
        </div>
        <div class="footer-links">
          <a href="/" data-i18n="nav.home">Inicio</a>
          <a href="mailto:observatorio@corpece.org.ec">Contacto</a>
        </div>
      </div>
      <div class="footer-bottom">
        <span class="footer-credit">Basado en DNSViz open source</span>
        <span class="footer-notice">Los datos analizados no son almacenados</span>
      </div>
    </div>
  </footer>

  <div id="toast-container" style="position:fixed;bottom:1.5rem;right:1.5rem;z-index:300;display:flex;flex-direction:column;gap:0.5rem"></div>

  <script src="/js/i18n.js"></script>
  <script src="/js/api.js"></script>
  <script src="/js/report.js"></script>
</body>
</html>
