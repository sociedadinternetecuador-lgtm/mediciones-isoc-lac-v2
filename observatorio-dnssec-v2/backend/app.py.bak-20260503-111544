_DB_SCHEMA = {
    'users':    [],
    'analyses': [],
    'domains':  [],
    'logs':     [],
    'tokens':   {}
}

def _db_load():
    if not os.path.exists(DB_FILE):
        return dict(_DB_SCHEMA)
    try:
        with open(DB_FILE) as f:
            db = json.load(f)
        for k, v in _DB_SCHEMA.items():
            db.setdefault(k, v)
        return db
    except Exception as e:
        log.error(f'db_load error: {e}')
        return dict(_DB_SCHEMA)

def _db_save(db):
    try:
        with open(DB_FILE, 'w') as f:
            json.dump(db, f, indent=2, default=str)
    except Exception as e:
        log.error(f'db_save error: {e}')

def _db_init():
    """Crea el admin por defecto si la base está vacía."""
    db = _db_load()
    if not db['users']:
        db['users'].append({
            'id':         _uid(),
            'email':      ADMIN_EMAIL,
            'password':   _hash(ADMIN_PASS),
            'role':       'admin',
            'active':     True,
            'last_login': None,
        })
        _db_save(db)
        log.info(f'Admin creado: {ADMIN_EMAIL}')

# ─────────────────────────────────────────────
# UTILIDADES
# ─────────────────────────────────────────────
def _uid():
    return secrets.token_hex(8)

def _hash(password: str) -> str:
    return hashlib.sha256((password + SECRET_KEY).encode()).hexdigest()

def _now() -> datetime:
    return datetime.now(timezone.utc)

def _now_iso() -> str:
    return _now().isoformat()

def _log(msg: str):
    db = _db_load()
    db['logs'].append({'ts': _now_iso(), 'msg': msg})
    db['logs'] = db['logs'][-500:]
    _db_save(db)

def _dnsviz_version() -> str:
    try:
        return subprocess.check_output(
            [DNSVIZ_CMD, '-v'],
            stderr=subprocess.STDOUT, text=True, timeout=5
        ).strip()
    except Exception:
        return 'unknown'

_LAYER_CACHE = None

def _load_layers() -> dict:
    global _LAYER_CACHE
    if _LAYER_CACHE is not None:
        return _LAYER_CACHE

    layer_files = {
        'capa1_catalogo_dnsviz': 'capa1-catalogo-dnsviz.json',
        'capa2_mapeo_normativo': 'capa2-mapeo-normativo.json',
        'capa3_explicaciones': 'capa3-explicaciones.json',
    }
    layers = {}
    for key, filename in layer_files.items():
        path = os.path.join(FRONTEND_DIR, 'data', filename)
        try:
            with open(path, encoding='utf-8') as f:
                layers[key] = json.load(f)
        except Exception as e:
            log.warning(f'No se pudo cargar {filename}: {e}')
            layers[key] = []

    by_code = {}
    for key, rows in layers.items():
        current = {}
        for row in rows:
            code = row.get('code') if isinstance(row, dict) else None
            if not code:
                continue
            if key == 'capa1_catalogo_dnsviz':
                current.setdefault(code, []).append(row)
            else:
                current[code] = row
        by_code[key] = current

    _LAYER_CACHE = {'raw': layers, 'by_code': by_code}
    return _LAYER_CACHE

def _enrich_issues_with_layers(issue_list: list) -> list:
    layers = _load_layers()['by_code']
    c1 = layers.get('capa1_catalogo_dnsviz', {})
    c2 = layers.get('capa2_mapeo_normativo', {})
    c3 = layers.get('capa3_explicaciones', {})

    for issue in issue_list:
        code = issue.get('code', '')
        missing = []
        if code not in c1:
            missing.append('capa1_catalogo_dnsviz')
        if code not in c2:
            missing.append('capa2_mapeo_normativo')
        if code not in c3:
            missing.append('capa3_explicaciones')
        issue['mapping'] = {
            'capa1_catalogo_dnsviz': c1.get(code, []),
            'capa2_mapeo_normativo': c2.get(code),
            'capa3_explicaciones': c3.get(code),
            'missing_layers': missing,
        }
    return issue_list

