# Copiar a .env y completar. Nunca commitear .env con valores reales.

PORT=8700

# Super administrador (única cuenta con permiso para crear/borrar otras
# cuentas admin). Generar ADMIN_PASSWORD_HASH con:
#   node scripts/hash-admin-password.js "tu-clave-elegida"
ADMIN_USERNAME=
ADMIN_PASSWORD_HASH=

# Secreto para firmar la cookie de sesión de /admin — cualquier cadena
# aleatoria larga, por ejemplo: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Solo para pruebas locales por http://localhost (sin HTTPS). NO usar en
# producción — ahí la cookie debe viajar siempre con el flag Secure.
# ADMIN_COOKIE_INSECURE=1

# SMTP (Brevo) — envío de contraseñas generadas por el sistema: alta de
# nuevos admins y recuperación de contraseña. Sin estas variables, /admin
# sigue funcionando pero "Crear administrador" y "Olvidé mi contraseña"
# fallarán con un error explícito (no crashea el servidor).
# IMPORTANTE: usar smtp-relay.sendinblue.com, NO smtp-relay.brevo.com — este
# último da error de certificado TLS (verificado contra el relay real).
SMTP_HOST=smtp-relay.sendinblue.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Mediciones ISOC-LAC <noreply@corpece.org.ec>"

# A esta dirección se envía la recuperación de contraseña del super_admin
# (esa cuenta no tiene email propio, vive solo en este .env).
SUPER_ADMIN_RECOVERY_EMAIL=corpeceorg@gmail.com

# A esta dirección se envían las alertas del chequeo periódico (canario,
# scripts/canary-check.js) si algo falla. Si no está definida, usa
# SUPER_ADMIN_RECOVERY_EMAIL como respaldo.
CANARY_ALERT_EMAIL=corpeceorg@gmail.com

# Servicio externo de conversión Markdown -> PDF (mdtopdf, ya desplegado),
# usado por "Análisis comparativo" (sub-tab de Mediciones) para exportar el
# reporte final. Sin esta variable se usa el valor por defecto (server1:8600).
MDTOPDF_URL=http://server1:8600

# Orígenes permitidos (separados por coma) en la cabecera CORS de
# GET /ged2026/api/v1/summary — el portal informativo consume este
# endpoint desde el navegador. Nunca dejar "*" en producción; sin esta
# variable el código usa "https://isoc.org.ec,https://www.isoc.org.ec"
# como valor por defecto (el dominio raíz redirige a "www" en producción,
# así que el Origin real que envía el navegador es el de "www" —
# verificado en vivo el 2026-09-22).
GED2026_PORTAL_ORIGIN=https://isoc.org.ec,https://www.isoc.org.ec

# API key de URLhaus (abuse.ch) para el check "malware" — registrarse en
# https://auth.abuse.ch/ para obtenerla. Sin esta variable, la consulta a
# urlhaus-api.abuse.ch igual se intenta pero la API responde 401 (verificado
# en vivo, 2026-09-13) — el check queda correctamente en INCONCLUSIVE, nunca
# se muestra como "sin reportes" sin haber consultado la fuente de verdad.
URLHAUS_AUTH_KEY=

# API key de ISOC Pulse (pulse.internetsociety.org/en/api/) para contexto
# país real (DNSSEC, ROA, IPv6, resiliencia) junto al análisis de dominios —
# ver PLAN_INTEGRACION_PULSE_API.md en data/exercises/. Sin esta variable,
# logic/adapters/pulse.adapter.js lanza PULSE_NOT_CONFIGURED y la tarjeta de
# contexto simplemente no se muestra; el resto del análisis sigue igual.
PULSE_API_KEY=
# Opcionales — por defecto: https://pulse-api.internetsociety.org, 15000, 24h.
# PULSE_API_BASE_URL=
# PULSE_REQUEST_TIMEOUT_MS=
# PULSE_CACHE_TTL_MS=

# URL del Observatorio DNSSEC v2 (ejecuta dnsviz real) para enriquecer el
# motor DNSSEC con evidencia criptográfica real (RRSIG/NSEC/etc.), no solo
# presencia de DS/DNSKEY. Ver logic/adapters/dnsviz.adapter.js. Sin esta
# variable, el adaptador devuelve {available:false} y nada se ve afectado.
# AÚN NO conectado a logic/rules/dnssec.rules.js (motor protegido en
# CLAUDE.md) — adaptador probado y aislado, a la espera de esa decisión.
DNSVIZ_OBSERVATORIO_URL=https://dnssec.corpece.org.ec
# Opcionales — por defecto: 15000ms, 90000ms.
# DNSVIZ_OBSERVATORIO_TIMEOUT_MS=
# DNSVIZ_OBSERVATORIO_MAX_WAIT_MS=
